{
  "name": "otcflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @otcflow/web",
    "dev:api": "npm run dev -w @otcflow/api",
    "build": "npm run build -w @otcflow/shared && npm run build -w @otcflow/web",
    "db:generate": "npm run db:generate -w @otcflow/api",
    "db:migrate": "npm run db:migrate -w @otcflow/api",
    "db:seed": "npm run db:seed -w @otcflow/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
