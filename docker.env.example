# Copy to `.env` at the repo root (optional — defaults below work for local Docker).
#
# ┌─────────────────────┬──────────────────────────────────────────────────┐
# │ Variable            │ Who reads it                                     │
# ├─────────────────────┼──────────────────────────────────────────────────┤
# │ VITE_API_URL        │ Web build (browser REST calls)                   │
# │ VITE_WS_URL         │ Web build (browser WebSocket)                    │
# │ API_PORT            │ Host port → api container                        │
# │ WEB_PORT            │ Host port → web container (nginx listens on 80)  │
# │ CORS_ORIGIN         │ Api — must match the URL you open in the browser │
# │ POSTGRES_*          │ Postgres container + api DATABASE_URL            │
# └─────────────────────┴──────────────────────────────────────────────────┘
#
# Use localhost in VITE_* — the browser is on your machine, not inside Docker.

VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/deals

API_PORT=3000
WEB_PORT=5173

CORS_ORIGIN=http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=otcflow
