# Copy to apps/api/.env and adjust for your machine.
# Required for native dev (npm run dev:api). Not used inside Docker Compose
# (Compose injects DATABASE_URL and other vars on the api service).
#
# Never commit apps/api/.env — it may contain secrets.

# --- Database (required) ---
#
# Homebrew Postgres (typical): your Mac username, no password
# DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/otcflow?schema=public"
#
# Docker Postgres on host (Compose default host port 5433):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/otcflow?schema=public"
#
# Local Postgres with postgres user:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otcflow?schema=public"

# --- HTTP server ---
# PORT=3000

# --- CORS ---
# Browser origin allowed to call the API. Must match where you open the web UI.
# Local Vite default:
# CORS_ORIGIN=http://localhost:5173
# Docker Compose default (same):
# CORS_ORIGIN=http://localhost:5173
# Production example (set to your deployed frontend origin):
# CORS_ORIGIN=https://app.example.com

# --- Runtime ---
# NODE_ENV=development
