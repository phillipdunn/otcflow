# Copy to apps/web/.env and adjust for your environment.
#
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# In Docker Compose, these are set as build args (see docker.env.example at repo root).
#
# Local dev (native): optional — defaults work when API runs on localhost:3000.
# Production / staging: set to the public API origin the browser will call.

# REST base URL (no trailing slash). Default: http://localhost:3000
VITE_API_URL=http://localhost:3000

# WebSocket URL for deal events. Optional — derived from VITE_API_URL when omitted.
# Must use ws:// or wss:// and path /ws/deals. Example: ws://localhost:3000/ws/deals
# VITE_WS_URL=ws://localhost:3000/ws/deals
